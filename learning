def mulai_kuis(topik_dipilih, jumlah, acak_opsi):
    pool = [i for i, s in enumerate(SOAL) if s["topik"] in topik_dipilih]
    random.shuffle(pool)
    pool = pool[:jumlah]

    urutan_opsi = {}
    for i in pool:
        idx = list(range(len(SOAL[i]["opsi"])))
        if acak_opsi:
            random.shuffle(idx)
        urutan_opsi[i] = idx

    st.session_state.update(
        {
            "fase": "kuis",
            "soal_ids": pool,
            "urutan_opsi": urutan_opsi,
            "posisi": 0,
            "jawaban_user": {},  # id soal -> indeks opsi asli yang dipilih
            "sudah_dijawab": set(),
        }
    )


def reset():
    for k in ["fase", "soal_ids", "urutan_opsi", "posisi", "jawaban_user", "sudah_dijawab"]:
        st.session_state.pop(k, None)
    st.session_state["fase"] = "menu"


if "fase" not in st.session_state:
    st.session_state["fase"] = "menu"


# ---------------------------------------------------------------------------
# TAMPILAN
# ---------------------------------------------------------------------------
def tampil_pembahasan(s):
    st.markdown("#### 📖 Cara menjawab")
    st.info(f"**Konsep kunci:** {s['konsep']}")
    for n, langkah in enumerate(s["langkah"], start=1):
        st.markdown(f"**Langkah {n}.** {langkah}")
    benar = s["opsi"][s["jawaban"]]
    st.success(f"Jawaban benar: {benar}")


def halaman_menu():
    st.title("📐 Quiz Matematika Kelas 12 SMA")
    st.write(
        "Latihan soal pilihan ganda dengan **pembahasan langkah demi langkah** "
        "setelah kamu menjawab."
    )

    topik = st.multiselect("Pilih topik", SEMUA_TOPIK, default=SEMUA_TOPIK)
    tersedia = sum(1 for s in SOAL if s["topik"] in topik)

    if tersedia == 0:
        st.warning("Pilih minimal satu topik.")
        return

    jumlah = st.slider(
        "Jumlah soal",
        min_value=1,
        max_value=tersedia,
        value=min(10, tersedia),
    ) if tersedia > 1 else 1
    acak_opsi = st.checkbox("Acak urutan pilihan jawaban", value=True)

    if st.button("🚀 Mulai Kuis", type="primary", use_container_width=True):
        mulai_kuis(topik, jumlah, acak_opsi)
        st.rerun()


def halaman_kuis():
    ids = st.session_state["soal_ids"]
    pos = st.session_state["posisi"]
    total = len(ids)
    sid = ids[pos]
    s = SOAL[sid]
    urutan = st.session_state["urutan_opsi"][sid]
    sudah = sid in st.session_state["sudah_dijawab"]

    st.progress(pos / total, text=f"Soal {pos + 1} dari {total}")
    st.caption(f"Topik: {s['topik']}")
    st.markdown(f"### {s['soal']}")

    pilihan_label = [f"{HURUF[i]}. {s['opsi'][asli]}" for i, asli in enumerate(urutan)]
    pilihan = st.radio(
        "Pilih jawaban:",
        options=list(range(len(urutan))),
        format_func=lambda i: pilihan_label[i],
        index=None,
        key=f"radio_{sid}",
        disabled=sudah,
    )

    if not sudah:
        if st.button("✅ Periksa Jawaban", type="primary", disabled=pilihan is None):
            st.session_state["jawaban_user"][sid] = urutan[pilihan]
            st.session_state["sudah_dijawab"].add(sid)
            st.rerun()
    else:
        dipilih = st.session_state["jawaban_user"][sid]
        if dipilih == s["jawaban"]:
            st.success("🎉 Benar!")
        else:
            st.error("❌ Belum tepat.")
        tampil_pembahasan(s)

        terakhir = pos == total - 1
        label = "🏁 Lihat Hasil" if terakhir else "➡️ Soal Berikutnya"
        if st.button(label, type="primary"):
            if terakhir:
                st.session_state["fase"] = "hasil"
            else:
                st.session_state["posisi"] += 1
            st.rerun()

    st.divider()
    if st.button("⬅️ Keluar ke menu"):
        reset()
        st.rerun()


def halaman_hasil():
    ids = st.session_state["soal_ids"]
    jawaban = st.session_state["jawaban_user"]
    benar = sum(1 for i in ids if jawaban.get(i) == SOAL[i]["jawaban"])
    total = len(ids)
    nilai = round(benar / total * 100)

    st.title("🏁 Hasil Kuis")
    c1, c2, c3 = st.columns(3)
    c1.metric("Benar", benar)
    c2.metric("Salah", total - benar)
    c3.metric("Nilai", nilai)

    if nilai >= 80:
        st.balloons()
        st.success("Mantap! Pemahamanmu sudah sangat baik.")
    elif nilai >= 60:
        st.info("Lumayan! Pelajari lagi pembahasan soal yang salah.")
    else:
        st.warning("Jangan menyerah, baca pembahasannya lalu coba lagi.")

    # Rekap per topik
    st.markdown("#### Rekap per topik")
    rekap = {}
    for i in ids:
        t = SOAL[i]["topik"]
        rekap.setdefault(t, [0, 0])
        rekap[t][1] += 1
        if jawaban.get(i) == SOAL[i]["jawaban"]:
            rekap[t][0] += 1
    for t, (b, n) in rekap.items():
        st.write(f"**{t}**: {b}/{n}")
        st.progress(b / n)

    st.markdown("#### Tinjau jawaban")
    for no, i in enumerate(ids, start=1):
        s = SOAL[i]
        ok = jawaban.get(i) == s["jawaban"]
        with st.expander(f"{'✅' if ok else '❌'} Soal {no} — {s['topik']}"):
            st.markdown(s["soal"])
            st.markdown(f"**Jawabanmu:** {s['opsi'][jawaban[i]]}")
            tampil_pembahasan(s)

    col1, col2 = st.columns(2)
    if col1.button("🔁 Ulangi dengan soal baru", use_container_width=True):
        reset()
        st.rerun()
    if col2.button("🏠 Menu utama", use_container_width=True):
        reset()
        st.rerun()


fase = st.session_state["fase"]
if fase == "menu":
    halaman_menu()
elif fase == "kuis":
    halaman_kuis()
else:
    halaman_hasil()
